# Razorpay Test Mode credentials — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook signing secret — Dashboard -> Settings -> Webhooks -> (your endpoint) -> Secret.
# Required for POST /agent/v1/webhooks/razorpay to accept real, signed events.
RAZORPAY_WEBHOOK_SECRET=change-me-in-production

# Server
PORT=4000

# Guardrail defaults (paise-free, in INR rupees) — seeds Policy v1 for every
# newly signed-up merchant; use POST /agent/v1/policy/draft + /publish to
# change limits per-merchant after signup.
DEFAULT_AUTO_LIMIT_INR=1500
MAX_AUTO_DISCOUNT_PCT=10

# HMAC secret used to mock-verify AP2 signed tokens and NPCI UAP delegation tokens
A_COS_MANDATE_SIGNING_SECRET=change-me-in-production

# --- Multi-tenant platform config (new) ---------------------------------

# Postgres connection string. Matches docker-compose.yml for local dev.
DATABASE_URL=postgresql://acos:acos_dev_password@localhost:5432/acos?schema=public

# Signs dashboard-login JWTs. MUST be a long random value in production —
# generate with `openssl rand -hex 32`. Anyone with this secret can forge a
# merchant session.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# JWT session lifetime, in seconds. 7 days by default.
JWT_EXPIRES_IN_SEC=604800

# Bcrypt cost factor for merchant password hashing.
BCRYPT_SALT_ROUNDS=12

# --- Inventory reservation holds + expiry sweep (new) -------------------

# How long a checkout's reserved stock stays held before it's released
# back to the pool if nobody completes payment, in seconds. Also used as
# the checkout session's payment-window length. Default 900 = 15 minutes.
INVENTORY_HOLD_TTL_SEC=900

# How often the background sweep checks for expired holds/sessions, in
# seconds. Default 60.
SCHEDULER_INTERVAL_SEC=60

# --- AI Storefront — real, LLM-backed conversational agent (new) --------

# Optional. Without it, POST /agent/v1/storefront/chat still works but
# returns a clearly-labeled static fallback reply instead of a real
# model-generated one — same graceful-without-a-key pattern as the
# Razorpay/SMTP integrations. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model the storefront agent calls. Defaults to a fast, cheap
# model — change to a larger one if you want richer reasoning.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
